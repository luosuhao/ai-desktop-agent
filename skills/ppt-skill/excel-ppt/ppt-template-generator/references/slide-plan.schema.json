{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/slide-plan.schema.json",
  "title": "PPT Slide Plan",
  "type": "object",
  "required": ["version", "sourceManifest", "generatedAt", "slides"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "sourceManifest": {"type": "string"},
    "layoutRegistry": {"type": "string"},
    "chartAssets": {"type": "string"},
    "generatedAt": {"type": "string"},
    "templateId": {"type": "string"},
    "summary": {"type": "object", "additionalProperties": true},
    "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
    "slides": {"type": "array", "items": {"$ref": "#/$defs/slide"}}
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["sectionId", "title", "groupIds"],
      "properties": {
        "sectionId": {"type": "string"},
        "title": {"type": "string"},
        "groupIds": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "slide": {
      "type": "object",
      "required": ["slideId", "role", "title", "template", "content"],
      "properties": {
        "slideId": {"type": "string"},
        "role": {"type": "string", "enum": ["cover", "toc", "section", "content", "closing"]},
        "title": {"type": "string"},
        "template": {"type": "object", "additionalProperties": true},
        "content": {"type": "object", "additionalProperties": true},
        "layoutHint": {"type": "object", "additionalProperties": true},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
